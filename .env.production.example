# Production Environment Variables — Voxentra (Vercel + VPS Baileys)
# Copy ke Vercel → Settings → Environment Variables (Production).
# Full procedure: docs/DEPLOY_RUNBOOK_VERCEL_VPS.md
# NEVER commit real keys.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_jwt_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt_here

# App
NEXT_PUBLIC_APP_URL=https://voxentra-crm.com
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# Baileys on VPS (server-side only — do not expose HTTP VPS as NEXT_PUBLIC_*)
WHATSAPP_SERVICE_URL=http://129.226.81.114:3001
# Optional shared secret for baileys-incoming / baileys-status (must match VPS)
WHATSAPP_BRIDGE_SECRET=generate_a_long_random_string

# Meta Cloud API (optional — only if not using Baileys for that channel)
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_API_URL=https://graph.facebook.com/v22.0

# Redis (optional — not required for agent chat direct-send)
# REDIS_URL=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Sentry (optional)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# --- VPS whatsapp-service/.env (reference; keep on server only) ---
# PORT=3001
# FRONTEND_URL=https://voxentra-crm.com
# CRM_APP_URL=https://voxentra-crm.com
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_KEY=   # leave empty for bridge mode
# WHATSAPP_BRIDGE_SECRET=same_as_vercel
# DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
